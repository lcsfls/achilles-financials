#!/bin/sh
set -e

case "$1" in
  remove)
    systemctl disable achilles-financials.service >/dev/null 2>&1 || true
    systemctl daemon-reload >/dev/null 2>&1 || true
    ;;
  purge)
    systemctl disable achilles-financials.service >/dev/null 2>&1 || true
    systemctl daemon-reload >/dev/null 2>&1 || true
    # Only purge removes the data. `apt remove` must never delete someone's
    # financial records — that has to be an explicit decision.
    echo "  Entferne /var/lib/achilles-financials (Datenbank inklusive)."
    rm -rf /var/lib/achilles-financials
    rm -rf /etc/achilles-financials
    if getent passwd achilles >/dev/null; then
      deluser --system achilles >/dev/null 2>&1 || true
    fi
    ;;
esac

exit 0
