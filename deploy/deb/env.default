# Achilles Financials — Konfiguration
#
# Nach Änderungen neu starten:  systemctl restart achilles-financials

# Port, auf dem das Dashboard lauscht
PORT=3000

# Adresse, an die gebunden wird.
# 127.0.0.1 = nur lokal (empfohlen, wenn ein Reverse Proxy davorsteht)
# 0.0.0.0   = im ganzen Netz erreichbar
HOSTNAME=0.0.0.0

# Die URL, unter der das Dashboard vom Smartphone aus erreichbar ist.
# Wird für den QR-Code beim Verbinden der Bank gebraucht — ohne korrekten
# Wert führt der Rücksprung von der Bank ins Leere.
# APP_URL=https://achilles.example.de

NODE_ENV=production
DATA_DIR=/var/lib/achilles-financials
